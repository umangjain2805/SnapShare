NODE_ENV=development
APP_URL=http://localhost:5173
API_PORT=4000
MONGODB_URI=mongodb://localhost:27017/snapshare?replicaSet=rs0
REDIS_URL=redis://localhost:6379
SESSION_DAYS=7
LOG_LEVEL=info
# Local emulator values only. Use private AWS S3 + a backend IAM role in production.
S3_BUCKET=snapshare-private
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=local-development
S3_SECRET_ACCESS_KEY=local-development

WORKER_INTERVAL_MS=10000
METADATA_RETENTION_DAYS=7
EMAIL_PROVIDER=disabled
# Optional HTTPS email webhook: EMAIL_WEBHOOK_URL and EMAIL_WEBHOOK_TOKEN

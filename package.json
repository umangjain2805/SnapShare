{
  "name": "snapshare",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "storage:setup": "pnpm --filter api storage:setup",
    "test:browser:workspace": "pnpm prepare:shared && tsx tests/browser/workspace.smoke.ts",
    "dev": "pnpm prepare:shared && pnpm -r --parallel dev",
    "lint": "eslint .",
    "typecheck": "pnpm prepare:shared && pnpm -r typecheck && tsc -p tests/tsconfig.json",
    "build": "pnpm -r build",
    "test": "pnpm prepare:shared && vitest run",
    "test:integration": "pnpm prepare:shared && vitest run tests/integration",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "test:browser": "pnpm prepare:shared && tsx tests/browser/auth.smoke.ts",
    "prepare:shared": "pnpm --filter @snapshare/contracts build && pnpm --filter @snapshare/backend build",
    "test:worker": "pnpm prepare:shared && pnpm --filter worker build && tsx tests/worker/runtime.smoke.ts",
    "benchmark": "pnpm prepare:shared && tsx benchmarks/run.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "argon2": "^0.44.0",
    "eslint": "^9.39.0",
    "mongodb-memory-server": "^10.3.0",
    "supertest": "^7.1.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.4"
  },
  "type": "module"
}

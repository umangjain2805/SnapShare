# Copy to .env.production on the target; never commit the populated file.
NODE_ENV=production
APP_URL=https://share.example.com
API_PORT=4000
WORKER_HEALTH_PORT=4001
MONGODB_URI=mongodb+srv://REPLACE_WITH_SECRET
REDIS_URL=rediss://REPLACE_WITH_SECRET:6379
S3_BUCKET=REPLACE_WITH_PRIVATE_NONVERSIONED_BUCKET
S3_REGION=us-east-1
# Use workload role credentials; do not set S3_ENDPOINT in production.
# Optional exact trusted reverse-proxy IP/CIDR, never 0.0.0.0/0.
TRUSTED_PROXIES=
LOG_LEVEL=info
SESSION_DAYS=7
WORKER_INTERVAL_MS=10000
METADATA_RETENTION_DAYS=7
EMAIL_PROVIDER=disabled
